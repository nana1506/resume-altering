{
  "framework": "nextjs",
  "functions": {
    "api/applications.py": {
      "maxDuration": 60
    },
    "api/cv.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/cv/:path*",
      "destination": "/api/cv.py"
    },
    {
      "source": "/api/applications/:path*",
      "destination": "/api/applications.py"
    },
    {
      "source": "/api/changes/:path*",
      "destination": "/api/applications.py"
    },
    {
      "source": "/api/user/:path*",
      "destination": "/api/user.py"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin.py"
    },
    {
      "source": "/api/access-requests",
      "destination": "/api/admin.py"
    },
    {
      "source": "/api/access-requests/:path*",
      "destination": "/api/admin.py"
    }
  ]
}
