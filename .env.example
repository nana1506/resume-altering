# Next.js Public Supabase Credentials (for frontend Auth and data fetching)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (for backend Python API with elevated storage/database operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Administrator Email (Root Admin)
ADMIN_EMAIL=isnan.rizqikurniawan@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=isnan.rizqikurniawan@gmail.com

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
